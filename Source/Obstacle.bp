'Importing our custom libraries
import "Mods\AdvEncoder"
import "Mods\AdvGyro"
import "Mods\ColorRGB"
import "Mods\SteerControl"
import "Mods\AdvUltrasonic"
import "Mods\Tool"
import "Mods\AdvPixy"

'Setting up proper mods for sensors
Sensor.SetMode(1, 0)
Sensor.SetMode(2, 4)
Sensor.SetMode(3, 0)
Sensor.SetMode(4, 0)

'Hard reset of gyro sensor
AdvGyro.CheckReset(3, result)
While result = 0
  Program.Delay(1000)
  AdvGyro.HardReset(3)
  AdvGyro.CheckReset(3, result)
EndWhile

'Reading configuration of color sensor
col = EV3File.OpenRead("col")
Rmin = EV3File.ConvertToNumber(EV3File.ReadLine(col))
Rmax = EV3File.ConvertToNumber(EV3File.ReadLine(col))
Gmin = EV3File.ConvertToNumber(EV3File.ReadLine(col))
Gmax = EV3File.ConvertToNumber(EV3File.ReadLine(col))
Bmin = EV3File.ConvertToNumber(EV3File.ReadLine(col))
Bmax = EV3File.ConvertToNumber(EV3File.ReadLine(col))
ColorRGB.Config(Rmin, Rmax, Gmin, Gmax, Bmin, Bmax)

'Configuration of our custom libraries
AdvGyro.ResetPort3(0)
AdvEncoder.Config()
SteerControl.Config(1.5, 0.05, 3, 35, 88)

'Setting up steering mechanism
MotorA.StartPower(-80)
Program.Delay(2000)
MotorA.ResetCount()

'Setting up basic values of our variables
angleKp = 0.8
angleKd = 1.2
angleOld = 0
clockWise = 0
turnCounter = 0
turnAngle = 91
UArtReady = 0
I2CReady = 0
SteeringReady = 0
DisplayReady = 0
aimx=30
distance=2000
yCameraRange=20

Sub UArt
  UArtReady = 1
  While 1=1
    AdvGyro.WritePort3(gyroAngle)
    ColorRGB.ReadPort2(r, g, b)
    AdvUltrasonic.ReadPort1(Distance)
  EndWhile
EndSub

Sub I2C
  I2CReady = 1
  While 1=1
    AdvPixy.getLargest(4, pixyX, pixyY, signature)
  EndWhile
EndSub

Sub Steering
  SteeringReady = 1
  While 1=1
    SteerControl.Core(MotorA.GetTacho(), powerC)
    MotorA.StartPower(powerC)
  EndWhile
EndSub

Sub Display
  DisplayReady = 1
  While 1=1
    If @Distance >= 100 Then
      @Distance = 0
    EndIf
    count = @Distance / 10
    Txt = ""
    While count > 0
      Txt = Text.Append(Txt, "@")
      count -= 1
    EndWhile
    LCD.Text(1, 10, 10, 2, Txt)
    Program.Delay(25)
    LCD.Clear()
  EndWhile
EndSub

Function ColorCheck(out number isWhite, out number isOrange)
  If @b < 55 Then
    isWhite = 0
  Else
    isWhite = 1
  EndIf
  If @r > 85 Then
    isOrange = 1
  Else
    isOrange = 0
  EndIf
EndFunction

Function AngleCore(in number angle, out number aim)
  aim = @angleKp * angle + @angleKd * (angle - @angleOld)
  @angleOld = angle
EndFunction

Function Reset(in number turnAngle)
  If @clockWise = 0 Then
    AdvGyro.ResetPort3(@gyroAngle + turnAngle)
  Else
    AdvGyro.ResetPort3(@gyroAngle - turnAngle)
  EndIf
  AdvGyro.WritePort3(@gyroAngle)
  @turnCounter++
  Speaker.Tone(100,300,50)
  Time.Reset1()
EndFunction

Function DetourObstacle()
  If @signature = 2 Then
    desiredX = -0.0025 * @pixyY * @pixyY + 0.8 * @pixyY + 35
    EV3.SetLEDColor("GREEN", "NORMAL")
  Else
    desiredX = 0.0025 * @pixyY * @pixyY - 0.8 * @pixyY - 35
    EV3.SetLEDColor("RED", "NORMAL")
  EndIf
  SteerControl.SetTarget((desiredX - @pixyX) * 1)
  EV3.SetLEDColor("NONE", "NORMAL")
EndFunction

Function Autopilot(in number variant)
  If @signature = 0 Or @Distance>75 Or @Distance<15 Then
    If variant = 0 Then
      Center()
    Else
      AngleCore(@gyroAngle, angle)
      SteerControl.SetTarget(angle)
    EndIf
  Else
    MotorB.SetPower(100)
    DetourObstacle()
  EndIf
EndFunction

Function Center()
  If @Distance >= 100 Then
    temp=1
  Else
    temp=0
  EndIf
  Tool.select(temp, 0, @Distance, dist)
  dist = 44 - Math.Cos(Math.GetRadians(@gyroAngle * 1.3)) * dist
  Tool.constrain(dist,-25,25,U)
  AngleCore((@gyroAngle+U) * 2.5,aim)
  SteerControl.SetTarget(aim)
EndFunction

Function GetOutOfParking()
  MotorB.StartPower(-35)
  While @gyroAngle > -30
    SteerControl.SetTarget(-45)
  EndWhile
  MotorB.ResetCount()
  While MotorB.GetTacho() > -800
    SteerControl.SetTarget(0)
  EndWhile
EndFunction
  

Function Start()
  isWhite = 1
  isOrange = 0
  MotorB.StartPower(60)
  While isWhite = 1
    Autopilot(1)
    ColorCheck(isWhite, isOrange)
  EndWhile
  @clockwise = isOrange
  Speaker.Tone(50, 3000, 100)
  arriv=200
  MotorB.ResetCount()
  Reset(@turnAngle)
EndFunction

Thread.Run = UArt
Thread.Run = I2C
Thread.Run = Steering
Thread.Run = Display

While UArtReady = 0 Or SteeringReady = 0 Or I2CReady = 0 Or DisplayReady = 0
  
EndWhile

GetOutOfParking()

Start()

While turnCounter<12
  isWhite = 1
  isOrange = 0
  While @clockWise<>isOrange Or isWhite=1 Or Time.Get1() < 1000
    Autopilot(0)
    ColorCheck(isWhite, isOrange)
  EndWhile
  Speaker.Tone(50, 3000, 100)
  Reset(turnAngle)
EndWhile


MotorB.ResetCount()
'Reaching the finish point in the start area
While MotorB.GetTacho()<3000
  Center()
EndWhile

MotorB.OffAndBrake()

Program.Delay(5000)

MotorB.StartPower(40)


isWhite = 1
isOrange = 0
While @clockWise<>isOrange Or isWhite=1
  Center()
  ColorCheck(isWhite, isOrange)
EndWhile

Speaker.Tone(100, 3000, 300)

While @gyroAngle < 90
  SteerControl.SetTarget(-35)
EndWhile

MotorB.SetPower(-40)

MotorB.ResetCount()
While MotorB.GetTacho() > -900
  AngleCore(@gyroAngle - 90, angle)
  SteerControl.SetTarget(angle)
EndWhile

While @gyroAngle < 175
  SteerControl.SetTarget(35)
EndWhile

Reset(180)

MotorB.SetPower(30)

While Distance > 12
  dist = 32 - Math.Cos(Math.GetRadians(@gyroAngle * 1.3)) * Distance
  Tool.constrain(dist,-25,25,U)
  AngleCore((@gyroAngle+U) * 2.5,aim)
  SteerControl.SetTarget(aim)
EndWhile

MotorB.ResetCount()
While MotorB.GetTacho() < 350
  AngleCore(@gyroAngle, angle)
  SteerControl.SetTarget(angle)
EndWhile

While @gyroAngle < 55
  SteerControl.SetTarget(-35)
EndWhile

MotorB.ResetCount()
While MotorB.GetTacho() < 200
  AngleCore(@gyroAngle - 55, angle)
  SteerControl.SetTarget(angle)
EndWhile

While @gyroAngle > 5
  SteerControl.SetTarget(35)
EndWhile

'Breaking motors and playing finish sound
MotorB.OffAndBrake()
Speaker.Tone(100, 3000, 300)
Speaker.Wait()
Speaker.Tone(100, 3000, 300)
Speaker.Wait()
Speaker.Tone(100, 3000, 300)
Speaker.Wait()